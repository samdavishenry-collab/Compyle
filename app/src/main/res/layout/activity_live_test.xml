<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/green_light_bg">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/green_primary"
            android:title="@string/live_test_running"
            android:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_back" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Status Bar -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <TextView
                android:id="@+id/text_running_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/test_running_connected"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/green_primary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/text_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waiting for data..."
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Progress indicator -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:indeterminateTint="@color/green_primary"
        android:visibility="gone" />

    <!-- Sensor Data Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_margin="16dp">

        <!-- Soil Moisture Card -->
        <androidx.cardview.widget.CardView
            style="@style/SensorDataCard"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/moisture_color">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💧"
                    android:textSize="32sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    style="@style/SensorLabelText"
                    android:text="@string/soil_moisture"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/text_moisture_value"
                    style="@style/SensorValueText"
                    android:text="--%"
                    android:textColor="@color/white" />

                <ProgressBar
                    android:id="@+id/progress_bar_moisture"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progressTint="@color/white"
                    android:progressBackgroundTint="#4CAF50" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Temperature Card -->
        <androidx.cardview.widget.CardView
            style="@style/SensorDataCard"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/temperature_color">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌡️"
                    android:textSize="32sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    style="@style/SensorLabelText"
                    android:text="@string/temperature"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/text_temperature_value"
                    style="@style/SensorValueText"
                    android:text="--°C"
                    android:textColor="@color/white" />

                <ProgressBar
                    android:id="@+id/progress_bar_temperature"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progressTint="@color/white"
                    android:progressBackgroundTint="#FF5722" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Humidity Card -->
        <androidx.cardview.widget.CardView
            style="@style/SensorDataCard"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/humidity_color">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💨"
                    android:textSize="32sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    style="@style/SensorLabelText"
                    android:text="@string/humidity"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/text_humidity_value"
                    style="@style/SensorValueText"
                    android:text="--%"
                    android:textColor="@color/white" />

                <ProgressBar
                    android:id="@+id/progress_bar_humidity"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progressTint="@color/white"
                    android:progressBackgroundTint="#9C27B0" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Stop Test Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <Button
            android:id="@+id/button_stop_test"
            style="@style/ButtonPrimary"
            android:backgroundTint="@color/button_danger"
            android:text="@string/stop_test"
            android:drawableStart="@drawable/ic_stop"
            android:drawablePadding="8dp"
            android:enabled="false" />

    </LinearLayout>

</LinearLayout>