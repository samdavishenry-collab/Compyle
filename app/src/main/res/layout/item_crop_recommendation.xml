<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Crop Icon -->
        <TextView
            android:id="@+id/text_crop_emoji"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="🌾"
            android:textSize="32sp"
            android:gravity="center"
            android:layout_marginEnd="16dp" />

        <!-- Crop Information -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Crop Name and Suitability -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/text_crop_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Crop Name"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/text_suitability"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good match"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_primary"
                    android:background="@drawable/bg_suitability_badge"
                    android:padding="4dp" />

            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/text_crop_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Crop description here"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Growing Period -->
                <TextView
                    android:id="@+id/text_growing_period"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Growing period: 120-150 days"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:drawableStart="@drawable/ic_calendar"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical" />

                <!-- Water Needs -->
                <TextView
                    android:id="@+id/text_water_needs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Water needs: High"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:drawableStart="@drawable/ic_water"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>